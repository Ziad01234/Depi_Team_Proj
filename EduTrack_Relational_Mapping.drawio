<mxfile host="app.diagrams.net" modified="2026-10-31T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="mapping-1" name="1 - Relational Mapping (Identity &amp; Academic Structure)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="pt0" value="&lt;b&gt;1 - Relational Mapping (Identity &amp;amp; Academic Structure)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;SQL Server-oriented logical mapping • 24 tables total • Fields follow the supplied ERD&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1600" height="55" as="geometry" /></mxCell><mxCell id="t0_0" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Role&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;RoleId&lt;/b&gt;  &lt;font color='#475569'&gt;INT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;RoleName&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(50)&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;UQ&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="105" width="550" height="92" as="geometry" /></mxCell><mxCell id="t0_1" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt