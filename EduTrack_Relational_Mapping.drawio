font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;SubjectName&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(150)&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1180" y="308" width="550" height="92" as="geometry" /></mxCell><mxCell id="t0_9" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;ClassSubject&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;ClassId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK, FK → Class.ClassId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;SubjectId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK, FK → Subject.SubjectId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="497" width="550" height="92" as="geometry" /></mxCell><mxCell id="t0_10" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Topic&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;TopicId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;SubjectId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Subject.SubjectId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;TopicName&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(150)&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="605" y="572" width="550" height="117" as="geometry" /></mxCell><mxCell id="t0_11" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Lesson&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;LessonId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;TopicId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Topic.TopicId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Title&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(200)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Content&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(MAX)&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1180" y="422" width="550" height="142" as="geometry" /></mxCell><mxCell id="note0" value="&lt;b&gt;Datatype / mapping conventions&lt;/b&gt;&lt;br&gt;• BIGINT identifiers are proposed surrogate keys unless the ERD specifies a composite key.&lt;br&gt;• PK/FK/UQ markers show relational constraints; FK arrows identify referenced columns.&lt;br&gt;• DATETIME2 stores date/time; Duration is integer minutes; decimal precision is proposed for marks and percentages.&lt;br&gt;• Fields not present in the supplied ERD are intentionally not invented. Confirm exact SQL dialect/naming conventions before implementation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="1450" width="1680" height="115" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="mapping-2" name="2 - Relational Mapping (Sessions, Assessment &amp; Monitoring)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="pt1" value="&lt;b&gt;2 - Relational Mapping (Sessions, Assessment &amp;amp; Monitoring)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;SQL Server-oriented logical mapping • 24 tables total • Fields follow the supplied ERD&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1600" height="55" as="geometry" /></mxCell><mxCell id="t1_0" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Session&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;SessionId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;ClassId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Class.ClassId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Title&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(200)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;DateTime&lt;/b&gt;  &lt;font color='#475569'&gt;DATETIME2&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Duration&lt;/b&gt;  &lt;font color='#475569'&gt;INT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;minutes&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Status&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(20)&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="105" width="550" height="192" as="geometry" /></mxCell><mxCell id="t1_1" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Attendance&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;AttendanceId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;StudentId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Student.UserId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;SessionId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Session.SessionId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Status&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(20)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;RecordedAt&lt;/b&gt;  &lt;font color='#475569'&gt;DATETIME2&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="605" y="105" width="550" height="167" as="geometry" /></mxCell><mxCell id="t1_2" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Quiz&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;QuizId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;TeacherId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Teacher.UserId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;ClassId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Class.ClassId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Title&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(200)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Description&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(MAX)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;StartAt&lt;/b&gt;  &lt;font color='#475569'&gt;DATETIME2&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;NULL allowed&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;EndAt&lt;/b&gt;  &lt;font color='#475569'&gt;DATETIME2&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;NULL allowed&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;TotalQuestions&lt;/b&gt;  &lt;font color='#475569'&gt;INT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;DERIVED&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;TotalMarks&lt;/b&gt;  &lt;font color='#475569'&gt;DECIMAL(10,2)&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;DERIVED&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1180" y="105" width="550" height="267" as="geometry" /></mxCell><mxCell id="t1_3" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;QuizLesson&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;QuizId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK, FK → Quiz.QuizId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;LessonId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK, FK → Lesson.LessonId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="319" width="550" height="92" as="geometry" /></mxCell><mxCell id="t1_4" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Question&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;QuestionId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;QuizId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Quiz.QuizId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;QuestionText&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(MAX)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Mark&lt;/b&gt;  &lt;font color='#475569'&gt;DECIMAL(10,2)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;DisplayOrder&lt;/b&gt;  &lt;font color='#475569'&gt;INT&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="605" y="294" width="550" height="167" as="geometry" /></mxCell><mxCell id="t1_5" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;QuestionOption&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;OptionId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;QuestionId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Question.QuestionId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;OptionText&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(MAX)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;IsCorrect&lt;/b&gt;  &lt;font color='#475569'&gt;BIT&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;DisplayOrder&lt;/b&gt;  &lt;font color='#475569'&gt;INT&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1180" y="394" width="550" height="167" as="geometry" /></mxCell><mxCell id="t1_6" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;QuizAttempt&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;AttemptId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;StudentId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Student.UserId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;QuizId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Quiz.QuizId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;SubmittedAt&lt;/b&gt;  &lt;font color='#475569'&gt;DATETIME2&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Score&lt;/b&gt;  &lt;font color='#475569'&gt;DECIMAL(10,2)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Percentage&lt;/b&gt;  &lt;font color='#475569'&gt;DECIMAL(5,2)&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="433" width="550" height="192" as="geometry" /></mxCell><mxCell id="t1_7" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;StudentAnswer&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;AnswerId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;AttemptId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → QuizAttempt.AttemptId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;QuestionId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Question.QuestionId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;SelectedOptionId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → QuestionOption.OptionId; NULL only if unanswered&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="605" y="483" width="550" height="142" as="geometry" /></mxCell><mxCell id="t1_8" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;PerformanceThreshold&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;ThresholdId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;TeacherId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Teacher.UserId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Metric&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(100)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;ThresholdValue&lt;/b&gt;  &lt;font color='#475569'&gt;DECIMAL(10,2)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Severity&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(20)&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1180" y="583" width="550" height="167" as="geometry" /></mxCell><mxCell id="t1_9" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Alert&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;AlertId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;StudentId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Student.UserId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Type&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(100)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Severity&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(20)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Message&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(MAX)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Status&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(20)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;CreatedAt&lt;/b&gt;  &lt;font color='#475569'&gt;DATETIME2&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="647" width="550" height="217" as="geometry" /></mxCell><mxCell id="t1_10" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Recommendation&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;RecommendationId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;StudentId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → Student.UserId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Message&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(MAX)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Status&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(20)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;CreatedAt&lt;/b&gt;  &lt;font color='#475569'&gt;DATETIME2&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="605" y="647" width="550" height="167" as="geometry" /></mxCell><mxCell id="t1_11" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Notification&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;NotificationId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;UserId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;FK → ApplicationUser.UserId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Type&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(100)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;Message&lt;/b&gt;  &lt;font color='#475569'&gt;NVARCHAR(MAX)&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;IsRead&lt;/b&gt;  &lt;font color='#475569'&gt;BIT&lt;/font&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;CreatedAt&lt;/b&gt;  &lt;font color='#475569'&gt;DATETIME2&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1180" y="772" width="550" height="192" as="geometry" /></mxCell><mxCell id="note1" value="&lt;b&gt;Datatype / mapping conventions&lt;/b&gt;&lt;br&gt;• BIGINT identifiers are proposed surrogate keys unless the ERD specifies a composite key.&lt;br&gt;• PK/FK/UQ markers show relational constraints; FK arrows identify referenced columns.&lt;br&gt;• DATETIME2 stores date/time; Duration is integer minutes; decimal precision is proposed for marks and percentages.&lt;br&gt;• Fields not present in the supplied ERD are intentionally not invented. Confirm exact SQL dialect/naming conventions before implementation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="1450" width="1680" height="115" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="mapping-relations" name="3 - Relationships &amp; Cardinalities"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="relTitle" value="&lt;b&gt;Relationships &amp; Cardinalities&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Each listed FK is many-to-one from the child table to the referenced parent, unless noted as a junction relationship.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1600" height="60" as="geometry" /></mxCell><mxCell id="r0" value="&lt;b&gt;ApplicationUser.RoleId&lt;/b&gt;  →  &lt;b&gt;Role.RoleId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Role 1 → 0..N ApplicationUser&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Required FK; one primary role per user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="820" height="78" as="geometry" /></mxCell><mxCell id="r1" value="&lt;b&gt;Teacher.UserId&lt;/b&gt;  →  &lt;b&gt;ApplicationUser.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;ApplicationUser 1 → 0..1 Teacher&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Subtype row; same UserId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="820" height="78" as="geometry" /></mxCell><mxCell id="r2" value="&lt;b&gt;Student.UserId&lt;/b&gt;  →  &lt;b&gt;ApplicationUser.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;ApplicationUser 1 → 0..1 Student&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Subtype row; same UserId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="192" width="820" height="78" as="geometry" /></mxCell><mxCell id="r3" value="&lt;b&gt;Parent.UserId&lt;/b&gt;  →  &lt;b&gt;ApplicationUser.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;ApplicationUser 1 → 0..1 Parent&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Subtype row; same UserId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="192" width="820" height="78" as="geometry" /></mxCell><mxCell id="r4" value="&lt;b&gt;ParentStudent.ParentId&lt;/b&gt;  →  &lt;b&gt;Parent.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Parent 1 → 0..N ParentStudent&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Composite PK with StudentId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="284" width="820" height="78" as="geometry" /></mxCell><mxCell id="r5" value="&lt;b&gt;ParentStudent.StudentId&lt;/b&gt;  →  &lt;b&gt;Student.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Student 1 → 0..N ParentStudent&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Composite PK with ParentId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="284" width="820" height="78" as="geometry" /></mxCell><mxCell id="r6" value="&lt;b&gt;Class.TeacherId&lt;/b&gt;  →  &lt;b&gt;Teacher.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Teacher 1 → 0..N Class&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Every class has exactly one teacher&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="376" width="820" height="78" as="geometry" /></mxCell><mxCell id="r7" value="&lt;b&gt;ClassStudent.ClassId&lt;/b&gt;  →  &lt;b&gt;Class.ClassId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Class 1 → 0..N ClassStudent&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Composite PK with StudentId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="376" width="820" height="78" as="geometry" /></mxCell><mxCell id="r8" value="&lt;b&gt;ClassStudent.StudentId&lt;/b&gt;  →  &lt;b&gt;Student.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Student 1 → 0..N ClassStudent&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Composite PK with ClassId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="468" width="820" height="78" as="geometry" /></mxCell><mxCell id="r9" value="&lt;b&gt;ClassSubject.ClassId&lt;/b&gt;  →  &lt;b&gt;Class.ClassId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Class 1 → 0..N ClassSubject&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Composite PK with SubjectId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="468" width="820" height="78" as="geometry" /></mxCell><mxCell id="r10" value="&lt;b&gt;ClassSubject.SubjectId&lt;/b&gt;  →  &lt;b&gt;Subject.SubjectId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Subject 1 → 0..N ClassSubject&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Composite PK with ClassId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="820" height="78" as="geometry" /></mxCell><mxCell id="r11" value="&lt;b&gt;Topic.SubjectId&lt;/b&gt;  →  &lt;b&gt;Subject.SubjectId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Subject 1 → 0..N Topic&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Each Topic belongs to exactly one Subject&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="820" height="78" as="geometry" /></mxCell><mxCell id="r12" value="&lt;b&gt;Lesson.TopicId&lt;/b&gt;  →  &lt;b&gt;Topic.TopicId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Topic 1 → 0..N Lesson&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Each Lesson belongs to exactly one Topic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="652" width="820" height="78" as="geometry" /></mxCell><mxCell id="r13" value="&lt;b&gt;Session.ClassId&lt;/b&gt;  →  &lt;b&gt;Class.ClassId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Class 1 → 0..N Session&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Each Session belongs to exactly one Class&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="652" width="820" height="78" as="geometry" /></mxCell><mxCell id="r14" value="&lt;b&gt;Attendance.StudentId&lt;/b&gt;  →  &lt;b&gt;Student.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Student 1 → 0..N Attendance&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Attendance requires one Student&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="744" width="820" height="78" as="geometry" /></mxCell><mxCell id="r15" value="&lt;b&gt;Attendance.SessionId&lt;/b&gt;  →  &lt;b&gt;Session.SessionId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Session 1 → 0..N Attendance&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Attendance requires one Session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="744" width="820" height="78" as="geometry" /></mxCell><mxCell id="r16" value="&lt;b&gt;Quiz.TeacherId&lt;/b&gt;  →  &lt;b&gt;Teacher.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Teacher 1 → 0..N Quiz&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Quiz creator/owner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="836" width="820" height="78" as="geometry" /></mxCell><mxCell id="r17" value="&lt;b&gt;Quiz.ClassId&lt;/b&gt;  →  &lt;b&gt;Class.ClassId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Class 1 → 0..N Quiz&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Scopes quiz to a class&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="836" width="820" height="78" as="geometry" /></mxCell><mxCell id="r18" value="&lt;b&gt;QuizLesson.QuizId&lt;/b&gt;  →  &lt;b&gt;Quiz.QuizId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Quiz 1 → 1..N QuizLesson&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Composite PK with LessonId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="928" width="820" height="78" as="geometry" /></mxCell><mxCell id="r19" value="&lt;b&gt;QuizLesson.LessonId&lt;/b&gt;  →  &lt;b&gt;Lesson.LessonId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Lesson 1 → 0..N QuizLesson&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Composite PK with QuizId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="928" width="820" height="78" as="geometry" /></mxCell><mxCell id="r20" value="&lt;b&gt;Question.QuizId&lt;/b&gt;  →  &lt;b&gt;Quiz.QuizId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Quiz 1 → 1..N Question&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Each Question belongs to one Quiz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1020" width="820" height="78" as="geometry" /></mxCell><mxCell id="r21" value="&lt;b&gt;QuestionOption.QuestionId&lt;/b&gt;  →  &lt;b&gt;Question.QuestionId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Question 1 → 1..N QuestionOption&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Each option belongs to one Question&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="1020" width="820" height="78" as="geometry" /></mxCell><mxCell id="r22" value="&lt;b&gt;QuizAttempt.StudentId&lt;/b&gt;  →  &lt;b&gt;Student.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Student 1 → 0..N QuizAttempt&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;One attempt per quiz enforced with UQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1112" width="820" height="78" as="geometry" /></mxCell><mxCell id="r23" value="&lt;b&gt;QuizAttempt.QuizId&lt;/b&gt;  →  &lt;b&gt;Quiz.QuizId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Quiz 1 → 0..N QuizAttempt&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;One attempt per student enforced with UQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="1112" width="820" height="78" as="geometry" /></mxCell><mxCell id="r24" value="&lt;b&gt;StudentAnswer.AttemptId&lt;/b&gt;  →  &lt;b&gt;QuizAttempt.AttemptId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;QuizAttempt 1 → 1..N StudentAnswer&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Store one row per question in the attempt; unanswered questions keep SelectedOptionId = NULL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1204" width="820" height="78" as="geometry" /></mxCell><mxCell id="r25" value="&lt;b&gt;StudentAnswer.QuestionId&lt;/b&gt;  →  &lt;b&gt;Question.QuestionId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Question 1 → 0..N StudentAnswer&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Question answered in an attempt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="1204" width="820" height="78" as="geometry" /></mxCell><mxCell id="r26" value="&lt;b&gt;StudentAnswer.SelectedOptionId&lt;/b&gt;  →  &lt;b&gt;QuestionOption.OptionId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;QuestionOption 1 → 0..N StudentAnswer&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Selected option must belong to the same QuestionId recorded in StudentAnswer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1296" width="820" height="78" as="geometry" /></mxCell><mxCell id="r27" value="&lt;b&gt;PerformanceThreshold.TeacherId&lt;/b&gt;  →  &lt;b&gt;Teacher.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Teacher 1 → 0..N PerformanceThreshold&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Thresholds configured by teacher&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="1296" width="820" height="78" as="geometry" /></mxCell><mxCell id="r28" value="&lt;b&gt;Alert.StudentId&lt;/b&gt;  →  &lt;b&gt;Student.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Student 1 → 0..N Alert&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Separate from Recommendation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1388" width="820" height="78" as="geometry" /></mxCell><mxCell id="r29" value="&lt;b&gt;Recommendation.StudentId&lt;/b&gt;  →  &lt;b&gt;Student.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;Student 1 → 0..N Recommendation&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Separate from Alert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="1388" width="820" height="78" as="geometry" /></mxCell><mxCell id="r30" value="&lt;b&gt;Notification.UserId&lt;/b&gt;  →  &lt;b&gt;ApplicationUser.UserId&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;ApplicationUser 1 → 0..N Notification&lt;/font&gt;&lt;br&gt;&lt;font color='#475569' style='font-size:11px'&gt;Each Notification belongs to one User&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1480" width="820" height="78" as="geometry" /></mxCell><mxCell id="relFoot" value="&lt;b&gt;Relationship count:&lt;/b&gt; 31 FK relationships. Junction tables implement M:N relationships: ParentStudent, ClassStudent, ClassSubject, and QuizLesson." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="1550" width="1680" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="mapping-constraints" name="4 - Keys, Constraints &amp; Validation"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="conTitle" value="&lt;b&gt;Keys, Constraints &amp; Validation Rules&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Constraints derived from the supplied Requirements and ERD; distinguish database-enforceable rules from cross-row business validation.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1650" height="60" as="geometry" /></mxCell><mxCell id="s0" value="&lt;div style='font-size:15px;font-weight:bold;padding:7px;background:#EAF2F8'&gt;Primary keys &amp;amp; unique constraints&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• PK: Role.RoleId; ApplicationUser.UserId; Teacher.UserId; Student.UserId; Parent.UserId; Class.ClassId; Subject.SubjectId; Topic.TopicId; Lesson.LessonId; Session.SessionId; Attendance.AttendanceId; Quiz.QuizId; Question.QuestionId; QuestionOption.OptionId; QuizAttempt.AttemptId; StudentAnswer.AnswerId; PerformanceThreshold.ThresholdId; Alert.AlertId; Recommendation.RecommendationId; Notification.NotificationId.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Composite PK: ParentStudent(ParentId, StudentId); ClassStudent(ClassId, StudentId); ClassSubject(ClassId, SubjectId); QuizLesson(QuizId, LessonId).&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• UQ: Role.RoleName; ApplicationUser.Username; ApplicationUser.Email; Class.EnrollmentCode.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• UQ: Attendance(StudentId, SessionId) — prevents duplicate attendance for the same student/session.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• UQ: QuizAttempt(StudentId, QuizId) — enforces one attempt per student per quiz (FR-75/76, BR-09).&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• UQ: StudentAnswer(AttemptId, QuestionId) — at most one submitted answer per question per attempt.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• UQ: Question(QuizId, Order); QuestionOption(QuestionId, Order) — stable ordering without duplicates.&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="105" width="1680" height="371" as="geometry" /></mxCell><mxCell id="s1" value="&lt;div style='font-size:15px;font-weight:bold;padding:7px;background:#EAF2F8'&gt;Required relationships / nullability&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Every Class must have exactly one Teacher; Class.TeacherId is NOT NULL.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Each Attendance must reference exactly one Student and one Session; both FKs are NOT NULL.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Each QuizAttempt must reference exactly one Student and one Quiz; both FKs are NOT NULL.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Each StudentAnswer must reference exactly one QuizAttempt and one Question. SelectedOptionId references QuestionOption; allow NULL only when the workflow permits an unanswered question.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Quiz.StartAt and Quiz.EndAt are nullable because the requirement says dates/times apply &amp;#x27;when applicable&amp;#x27;; if every quiz must have a window, make both NOT NULL.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Teacher, Student, and Parent are role-specific extension rows. Enforce that each extension&amp;#x27;s ApplicationUser.RoleId matches its subtype, and that a user is not simultaneously assigned conflicting subtype rows.&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="491" width="1680" height="324" as="geometry" /></mxCell><mxCell id="s2" value="&lt;div style='font-size:15px;font-weight:bold;padding:7px;background:#EAF2F8'&gt;Cross-row / business validation&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Attendance.StudentId must be enrolled in the same Class as Attendance.SessionId → Session.ClassId.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Quiz.TeacherId must be the teacher authorized to manage Quiz.ClassId (BR-06).&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• QuizLesson must link a quiz to one or more lessons (FR-33/34, FR-53). A minimum of one row per quiz needs publish-time/application validation; a normal FK cannot enforce this.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Each QuizLesson lesson should be relevant to the quiz&amp;#x27;s class: Lesson → Topic → Subject must resolve to a Subject assigned to Quiz.ClassId through ClassSubject. This follows enrolled-subject access; enforce in service/database validation.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Every QuestionOption selected in StudentAnswer must belong to the same QuestionId stored in StudentAnswer. A plain FK on SelectedOptionId alone does not guarantee this; enforce the pair (QuestionId, SelectedOptionId) against QuestionOption(QuestionId, OptionId) using a composite FK with a matching unique key, or equivalent transactional validation.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Add UQ(QuestionOption.QuestionId, QuestionOption.OptionId) if enforcing the composite FK described above. Each MCQ question should have at least two options and exactly one correct option. A filtered unique index can enforce at most one correct option; at least one requires publish-time validation.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• QuizAttempt.QuizId and StudentId must agree with the class enrollment: the student must be actively enrolled in Quiz.ClassId when accessing/submitting the quiz. The QuestionId in each StudentAnswer must also belong to the same QuizId as its QuizAttempt; enforce this transactionally in the application/service or with an equivalent database constraint.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• A Quiz must contain at least one Question before it can be published (approved project rule; enforce at publish time). • Quiz.StartAt must be earlier than Quiz.EndAt when both are present. Session.Duration and Question.Mark should be positive; Percentage should be within 0–100; validate status/severity values against allowed sets.&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="1680" height="418" as="geometry" /></mxCell><mxCell id="s3" value="&lt;div style='font-size:15px;font-weight:bold;padding:7px;background:#EAF2F8'&gt;Calculated values &amp;amp; scope&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Quiz.TotalQuestions = COUNT(Question rows for QuizId); Quiz.TotalMarks = SUM(Question.Mark). Keep derived/computed in query or view; do not treat as independently editable source values.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• QuizAttempt.Score and Percentage are result snapshots calculated after submission and stored for result history.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Performance is derived from quiz attempts/results, attendance, and historical data; no Performance table in initial scope.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• No QuizTopic table or direct Quiz.TopicId; derive topic context through QuizLesson → Lesson → Topic.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• AI-specific entities are excluded from initial ERD; AI features remain future phase.&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="1263" width="1680" height="277" as="geometry" /></mxCell><mxCell id="s4" value="&lt;div style='font-size:15px;font-weight:bold;padding:7px;background:#EAF2F8'&gt;Explicitly preserve ERD scope&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• 24 tables included: Role, ApplicationUser, Teacher, Student, Parent, ParentStudent, Class, ClassStudent, Subject, ClassSubject, Topic, Lesson, Session, Attendance, Quiz, QuizLesson, Question, QuestionOption, QuizAttempt, StudentAnswer, PerformanceThreshold, Alert, Recommendation, Notification.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Alert, Recommendation, and Notification remain separate tables/concepts.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Teacher may have zero classes; Class may have zero students; Student may exist before enrollment.&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:6px 9px;font-size:12px'&gt;• Initial version: one attempt per student per quiz.&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="1555" width="1680" height="230" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="mapping-notes" name="5 - Assumptions &amp; Implementation Notes"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="assTitle" value="&lt;b&gt;Implementation Notes &amp; Decisions to Confirm&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1600" height="55" as="geometry" /></mxCell><mxCell id="n0" value="&lt;b&gt;SQL dialect&lt;/b&gt;&lt;br&gt;The supplied documents do not specify a database engine. Datatypes are proposed in SQL Server style (NVARCHAR, BIGINT, DATETIME2, BIT, DECIMAL); translate if using PostgreSQL/MySQL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="1660" height="95" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;User profile fields&lt;/b&gt;&lt;br&gt;The ERD only lists UserId, RoleId, Username, Email, PasswordHash, and IsActive on ApplicationUser. Profile attributes (e.g., display name/phone) are not added because they are not shown in the ERD." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="220" width="1660" height="95" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Delete behavior&lt;/b&gt;&lt;br&gt;Prefer RESTRICT/NO ACTION for academic records and submitted attempts; use soft deactivation/status where history must be retained. Exact cascade policy is not specified in the requirements." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="1660" height="95" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Role cardinality&lt;/b&gt;&lt;br&gt;Requirements specify one primary role per user. The ERD subtype tables imply role-specific records; enforce role/subtype consistency and exactly one matching subtype for Teacher/Student/Parent accounts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="440" width="1660" height="95" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Question options and unanswered questions&lt;/b&gt;&lt;br&gt;The initial release supports MCQ only (FR-63). Store one StudentAnswer row per question in an attempt. SelectedOptionId is nullable: if the student skips a question, retain the answer row with SelectedOptionId = NULL so the result can display it as unanswered. Grade unanswered questions as zero; do not omit the row." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="550" width="1660" height="95" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Quiz / lesson / question minimums&lt;/b&gt;&lt;br&gt;Each quiz must be associated with at least one lesson before publication (FR-33/34, FR-53). Also, by the approved project decision, a quiz must contain at least one question before publication. Both minimums require publish-time/application validation; ordinary foreign keys cannot enforce a minimum child-row count." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="1660" height="95" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Derived totals&lt;/b&gt;&lt;br&gt;TotalQuestions and TotalMarks are marked DERIVED in the ERD and are intentionally not persisted as ordinary editable columns." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3B8CC;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="1660" height="95" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>