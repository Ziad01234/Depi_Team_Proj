icationUser.UserId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1180" y="105" width="550" height="67" as="geometry" /></mxCell><mxCell id="t0_3" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Student&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;UserId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK, FK → ApplicationUser.UserId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="219" width="550" height="67" as="geometry" /></mxCell><mxCell id="t0_4" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Parent&lt;/div&gt;&lt;div style='border-top:1px solid #E5E7EB;padding:3px 6px;font-size:12px'&gt;&lt;b&gt;UserId&lt;/b&gt;  &lt;font color='#475569'&gt;BIGINT&lt;/font&gt;  &lt;font color='#0F766E'&gt;&lt;i&gt;PK, FK → ApplicationUser.UserId&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=swimlane;html=1;startSize=30;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#EAF2F8;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="605" y="319" width="550" height="67" as="geometry" /></mxCell><mxCell id="t0_5" value="&lt;div style='font-size:15px;font-weight:bold;padding:6px 8px;background:#EAF2F8'&gt;Paren